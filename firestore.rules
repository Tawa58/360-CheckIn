rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isEmployeeAccount() {
      return request.auth.token.email.matches('.*@companycheckin\\.internal$');
    }

    function isAuthorizedAdminEmail() {
      return request.auth.token.email.lower() in [
        'test@gmail.com',
      ];
    }

    function isAdmin() {
      return signedIn() && isAuthorizedAdminEmail();
    }

    match /admins/{adminId} {
      allow read: if isAdmin() ||
        (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if isAdmin() ||
        (signedIn() &&
          request.resource.data.uid == request.auth.uid &&
          !isEmployeeAccount() &&
          request.resource.data.email == request.auth.token.email &&
          isAuthorizedAdminEmail());
      allow update, delete: if isAdmin();
    }

    match /employees/{employeeId} {
      allow read: if isAdmin() ||
        (signedIn() && resource.data.authUid == request.auth.uid);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
        (signedIn() &&
          resource.data.authUid == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['photoUrl', 'email', 'updatedAt']));
    }

    match /employeeMessages/{id} {
      allow create: if (signedIn()
          && request.resource.data.employeeUid == request.auth.uid
          && request.resource.data.kind in ['absence', 'issue']
          && request.resource.data.status == 'open')
        || (request.resource.data.kind == 'forgot'
          && request.resource.data.status == 'open'
          && request.resource.data.employeeUid == ''
          && request.resource.data.employeeId == 'FORGOT'
          && request.resource.data.email is string
          && request.resource.data.email.size() > 5
          && !request.resource.data.keys().hasAny(['adminReply']));
      allow get: if isAdmin() ||
        (signedIn() && resource.data.employeeUid == request.auth.uid) ||
        resource.data.kind == 'forgot';
      allow list: if isAdmin() ||
        (signedIn() && resource.data.employeeUid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /forgotLookups/{emailId} {
      allow get: if true;
      allow create, update: if request.resource.data.keys().hasAll(['requestId', 'email']);
      allow delete: if isAdmin();
    }

    match /usernames/{username} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /accessCodes/{code} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /attendance/{id} {
      allow read: if isAdmin() ||
        (signedIn() && resource.data.employeeUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.employeeUid == request.auth.uid
        && request.resource.data.locationStatus == 'Verified'
        && request.resource.data.latitude is number
        && request.resource.data.longitude is number;
      allow update, delete: if isAdmin();
    }

    match /settings/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /boundaryEvents/{id} {
      allow create: if signedIn()
        && request.resource.data.employeeUid == request.auth.uid
        && request.resource.data.eventType == 'EXIT'
        && request.resource.data.status == 'open';
      allow read: if isAdmin() ||
        (signedIn() && resource.data.employeeUid == request.auth.uid);
      allow update: if isAdmin() ||
        (signedIn()
          && resource.data.employeeUid == request.auth.uid
          && request.resource.data.employeeUid == resource.data.employeeUid
          && request.resource.data.employeeId == resource.data.employeeId
          && request.resource.data.eventId == resource.data.eventId
          && request.resource.data.exitTime == resource.data.exitTime
          && request.resource.data.eventDate == resource.data.eventDate
          && request.resource.data.geofenceId == resource.data.geofenceId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.eventType == 'EXIT');
      allow delete: if isAdmin();
    }
  }
}
